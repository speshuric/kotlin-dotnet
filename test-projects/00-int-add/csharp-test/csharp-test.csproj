<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>csharp-test</AssemblyName>
  </PropertyGroup>

  <!-- Ссылка на IL-сборку, сгенерированную через ilasm.
       manual.dll — hand-written (Phase 2-3)
       Arithmetic.dll — сгенерирована из Kotlin через плагин (Phase 5-6)
       Путь относительный к .csproj. -->
  <ItemGroup>
    <Reference Include="Arithmetic">
      <HintPath>..\..\..\build\Arithmetic.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>

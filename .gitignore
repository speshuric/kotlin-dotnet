# Локальные SDK (JDK, kotlinc, .NET, Gradle)
.sdk/

# Локальные исходники для референса (shallow clones).
# Игнорируем всё содержимое, кроме README.md (памятка).
.sources/*
!.sources/README.md

# Kotlin compiler daemon: логи ошибок и сессии (kotlinc -Xplugin=...)
.kotlin/

# Сборочные артефакты
build/
*/bin/
*/obj/
bin/
obj/

# .NET / IL
*.dll
*.exe
*.il
*.pdb
*.mdb
*.cache
*.tmp

# Gradle
.gradle/
gradle-app.setting
!gradle-wrapper.jar

# Kotlin
*.kotlin_metadata
*.kotlin_module

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Chat exports и логи сессий в корне — игнорируем.
# Они хранятся выборочно в discussions/ (см. ниже).
/chat-export-*.json
/*.log

# Discussions: chat-exports и выборочные логи сессий.
# По умолчанию новые файлы в discussions/ игнорируются, кроме README и .gitkeep.
# Конкретные чат-экспорты добавляются через !-правила по мере необходимости.
discussions/*
!discussions/README.md
!discussions/.gitkeep
!discussions/chat-export-1786958489540.json
